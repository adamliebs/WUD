<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Picked automatically by Xcode based on the signing config:
	     'development' for debug builds → APNs sandbox,
	     'production'  for release builds → APNs production.
	     Apple rejects the build if this is missing on a push-capable app. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
