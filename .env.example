# WUD web / native client — build-time configuration.
#
# Copy to `.env` for local development (gitignored). Vite inlines every
# VITE_* variable into the bundle at build time, so these are PUBLIC — never
# put secrets here.

# Base URL of the WUD backend API (no trailing slash).
#   local web dev : leave unset — the client falls back to http://localhost:4000
#   native builds : MUST be set to the deployed API, e.g. https://api.wud.app
#                   (a device cannot reach your machine's localhost)
VITE_API_URL=http://10.0.2.2:4000
