{
  "name": "wud-server",
  "version": "1.0.0",
  "private": true,
  "description": "WUD backend — REST API, realtime gateway, scheduler",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:tsx": "tsx src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/db/migrations dist/db/ && cp -R src/public dist/public",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.53.1",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.34.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/heic-convert": "^2.1.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
