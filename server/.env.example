# WUD backend — environment configuration.
#
# Local dev:   copy this file to `.env` (it is gitignored) and adjust.
# Production:  the host platform injects these as real environment variables.
#
# Anything marked REQUIRED must be set in production — the server refuses to
# boot otherwise (see src/config.ts).

# development | production | test
NODE_ENV=development

# HTTP port the API listens on.
PORT=4000

# SQLite database file. In production point this at a mounted, persistent
# volume (e.g. /data/wud.db) so it survives deploys and restarts.
WUD_DB=wud.db

# --- security ---------------------------------------------------------------

# HMAC secret for signing JWTs. REQUIRED in production, minimum 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Access / refresh token lifetimes, in seconds (15 min / 30 days).
ACCESS_TTL=900
REFRESH_TTL=2592000

# Comma-separated allowed client origins. REQUIRED in production.
# Includes the web client and the Capacitor native webview origins
# (capacitor://localhost = iOS, http(s)://localhost = Android).
CORS_ORIGIN=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost

# Number of reverse proxies in front of the app (1 behind a single load
# balancer) — needed for correct client IPs and rate limiting.
TRUST_PROXY=0

# --- rate limiting ----------------------------------------------------------

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
AUTH_RATE_LIMIT_MAX=20

# Max JSON request body size.
BODY_LIMIT=2mb

# --- observability ----------------------------------------------------------

# trace | debug | info | warn | error
LOG_LEVEL=debug

# Sentry DSN — leave blank to disable error tracking.
SENTRY_DSN=

# Release identifier (usually the git SHA), surfaced to Sentry and logs.
GIT_SHA=

# --- scheduler --------------------------------------------------------------

SCHEDULER_MS=30000

# --- Litestream backups (see litestream.yml) --------------------------------

# S3-compatible replica target for continuous DB backup/replication.
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
